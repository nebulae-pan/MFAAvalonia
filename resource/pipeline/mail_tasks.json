{
    "start_receive_mail": {
        "next": [
            "no_unread_mails",
            "process_mail_tasks",
            "[JumpBack]return_to_garage"
        ]
    },
    "process_mail_tasks": {
        "recognition": "TemplateMatch",
        "template": "daily/mails.png",
