        "action": "Click",
        "next": [
            "check_mail_received"
        ]
    },
    "check_mail_received": {
        "recognition": "OCR",
        "expected": "点击任意位置继续",
        "action": "Click",
        "next": [
            "return_to_garage"
        ]
    }
